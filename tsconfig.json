{
  "compilerOptions": {
    "target": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "lib": ["DOM", "ESNext"],
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "types": ["react", "react-dom", "vite/client"],
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
